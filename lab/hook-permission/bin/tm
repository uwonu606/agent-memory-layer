#!/bin/bash
cd "${LAB_ROOT:?LAB_ROOT에 실험 상태를 둘 폴더를 정한다}" || exit 1
T=(tmux -S tmux.sock)
sub=$1; shift
case "$sub" in
  start)
    name=$1; dir=$2; shift 2
    "${T[@]}" new-session -d -s "$name" -x 150 -y 50 -c "$dir" "$@"
    "${T[@]}" set-option -t "$name" history-limit 5000 >/dev/null
    ;;
  send)
    name=$1; shift
    "${T[@]}" send-keys -t "$name" -l "$*"
    sleep 0.5
    "${T[@]}" send-keys -t "$name" Enter
    ;;
  type)
    name=$1; shift
    "${T[@]}" send-keys -t "$name" -l "$*"
    ;;
  key)
    name=$1; shift
    "${T[@]}" send-keys -t "$name" "$@"
    ;;
  cap)
    name=$1; lines=${2:-0}
    "${T[@]}" capture-pane -p -t "$name" -S "-$lines"
    ;;
  wait)
    name=$1; pattern=$2; timeout=${3:-60}
    for ((i = 0; i < timeout; i++)); do
      if "${T[@]}" capture-pane -p -t "$name" -S -200 | grep -Eq "$pattern"; then exit 0; fi
      sleep 1
    done
    echo "timeout waiting for: $pattern" >&2
    exit 1
    ;;
  settle)
    name=$1; quiet=${2:-4}; timeout=${3:-180}; busy=${4:-esc to interrupt}
    prev=""; same=0
    for ((i = 0; i < timeout; i++)); do
      cur=$("${T[@]}" capture-pane -p -t "$name")
      if [ "$cur" = "$prev" ] && ! grep -q "$busy" <<<"$cur"; then
        same=$((same + 1))
        if [ "$same" -ge "$quiet" ]; then exit 0; fi
      else
        same=0
      fi
      prev=$cur
      sleep 1
    done
    echo "timeout waiting for screen to settle" >&2
    exit 1
    ;;
  alive)
    "${T[@]}" has-session -t "$1" 2>/dev/null && echo alive || echo dead
    ;;
  kill)
    "${T[@]}" kill-session -t "$1" 2>/dev/null
    ;;
  killall)
    "${T[@]}" kill-server 2>/dev/null
    ;;
  ls)
    "${T[@]}" list-sessions 2>/dev/null
    ;;
  *)
    echo "usage: tm start|send|type|key|cap|wait|settle|alive|kill|killall|ls" >&2
    exit 2
    ;;
esac
