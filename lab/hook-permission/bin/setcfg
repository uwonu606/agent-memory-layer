#!/usr/bin/env python3
import argparse
import json
import os

ROOT = os.environ["LAB_ROOT"]
HOME = os.environ.get("LAB_HOME", f"{ROOT}/home")
HOOKS = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "hooks")

parser = argparse.ArgumentParser(description="격리 home의 user settings를 실험용 hook과 넘겨받은 설정으로 다시 쓴다.")
parser.add_argument("--matcher", help="SessionStart hook의 matcher. 없으면 모든 시작 방식에 건다")
parser.add_argument("--no-session-hook", action="store_true", help="SessionStart hook을 걸지 않는다")
parser.add_argument("--subagent-hook", action="store_true", help="SubagentStart hook을 건다")
parser.add_argument("--post-tool-hook", action="store_true", help="Write와 Edit에 PostToolUse hook을 건다")
parser.add_argument("extra", nargs="*", help="settings에 합칠 JSON object")
args = parser.parse_args()

settings = {"hooks": {"PreToolUse": [{"hooks": [{"type": "command", "command": f"python3 {HOOKS}/pre-tool-guard.py"}]}]}}
if not args.no_session_hook:
    entry = {"hooks": [{"type": "command", "command": f"python3 {HOOKS}/session-start.py"}]}
    if args.matcher:
        entry["matcher"] = args.matcher
    settings["hooks"]["SessionStart"] = [entry]
if args.subagent_hook:
    settings["hooks"]["SubagentStart"] = [{"hooks": [{"type": "command", "command": f"python3 {HOOKS}/subagent-start.py"}]}]
if args.post_tool_hook:
    settings["hooks"]["PostToolUse"] = [{"matcher": "Write|Edit", "hooks": [{"type": "command", "command": f"python3 {HOOKS}/post-tool-dump.py"}]}]
for extra in args.extra:
    settings.update(json.loads(extra))

os.makedirs(f"{HOME}/.claude", exist_ok=True)
with open(f"{HOME}/.claude/settings.json", "w", encoding="utf-8") as f:
    json.dump(settings, f, ensure_ascii=False, indent=2)
print(json.dumps({k: v for k, v in settings.items() if k != "hooks"}, ensure_ascii=False),
      "| SessionStart matcher:", "(hook 없음)" if args.no_session_hook else args.matcher)
