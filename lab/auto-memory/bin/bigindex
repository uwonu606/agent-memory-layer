#!/usr/bin/env python3
import sys

path, line_count, line_bytes = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
filler = sys.argv[4] if len(sys.argv) > 4 else "x"
lines = []
for number in range(1, line_count + 1):
    head = f"- L{number:04d} "
    pad = line_bytes - len(head.encode()) - 1
    unit = len(filler.encode())
    lines.append(head + filler * (pad // unit) + "." * (pad % unit))
with open(path, "w", encoding="utf-8") as f:
    f.write("\n".join(lines) + "\n")
