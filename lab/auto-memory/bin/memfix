#!/usr/bin/env python3
import os
import sys

memory_dir, tag = sys.argv[1], sys.argv[2]
os.makedirs(memory_dir, exist_ok=True)

TOPICS = {
    "deploy-day": ("project", "배포 요일", f"이 프로젝트는 매주 목요일에만 배포한다. 표지 낱말은 TOPIC-{tag}-DEPLOY 이다."),
    "review-style": ("feedback", "리뷰 글투", f"코드 리뷰 댓글은 물음으로 끝낸다. 표지 낱말은 TOPIC-{tag}-REVIEW 이다."),
    "db-port": ("reference", "시험 DB의 port", f"시험 DB는 port 54329에서 돈다. 표지 낱말은 TOPIC-{tag}-DBPORT 이다."),
}

index_lines = []
for slug, (kind, title, body) in TOPICS.items():
    with open(os.path.join(memory_dir, f"{slug}.md"), "w", encoding="utf-8") as f:
        f.write(f"---\nname: {slug}\ndescription: {title}\nmetadata:\n  type: {kind}\n---\n\n{body}\n")
    index_lines.append(f"- [{title}]({slug}.md) — {title}에 관한 기억")

with open(os.path.join(memory_dir, "MEMORY.md"), "w", encoding="utf-8") as f:
    f.write(f"<!-- 표지 낱말 INDEX-{tag}-COMMENT -->\n" + "\n".join(index_lines) + f"\n- 표지 낱말 INDEX-{tag}-LINE 은 색인에만 있다\n")
print(memory_dir)
